<mvc:View
    controllerName="logaligroup.etiquetas.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <IconTabBar
                id="_IDGenIconTabBar1"
                class="sapUiResponsiveMargin"
                expandable="true"
            >
                <items>
                    <IconTabFilter
                        id="_IDGenIconTabFilter"
                        text="{i18n>tabReimpresion}"
                        key="reimpresion"
                    >
                        <VBox
                            id="_IDGenVBox"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="_IDGenLabel"
                                text="{i18n>labelFolio}"
                                labelFor="reimpFolio"
                            />
                            <Input
                                id="reimpFolio"
                                maxLength="11"
                                placeholder="{i18n>phFolio11}"
                                width="200px"
                            />
                            <Button
                                id="_IDGenButton"
                                text="{i18n>btnReimprimir}"
                                press="onReimprimir"
                                class="sapUiSmallMarginTop"
                                type="Emphasized"
                            />
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter
                        id="_IDGenIconTabFilter1"
                        text="{i18n>tabParticion}"
                        key="paritcion"
                    >
                        <VBox
                            id="_IDGenVBox1"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="_IDGenLabel1"
                                text="{i18>labelFolio}"
                                labelFor="partFolio"
                            />
                            <Input
                                id="partFolio"
                                maxLength="11"
                                placeholder="{i18n>phFolio11}"
                                width="200px"
                            />

                            <Label
                                id="_IDGenLabel2"
                                text="{i18n>labelCantidad1}"
                                labelFor="cant1"
                                class="sapUiSmallMarginTop"
                            />
                            <Input
                                id="cant1"
                                type="Number"
                                placeholder="{i18n>phCantidad1}"
                                width="200px"
                            />

                            <Label
                                id="_IDGenLabel3"
                                text="{i18n>labelCantidad2}"
                                labelFor="cant2"
                                class="sapUiSmallMarginTop"
                            />
                            <Input
                                id="cant2"
                                type="Number"
                                placeholder="{i18n>phCantidad2}"
                                width="200px"
                            />

                            <Button
                                id="_IDGenButton1"
                                text="{i18n>btnParticipar}"
                                press="onParticionar"
                                class="sapUiSamllMarginTop"
                                type="Emphasized"
                            />
                        </VBox>
                    </IconTabFilter>

                    <!--Unificacion-->

                    <IconTabFilter
                        id="_IDGenIconTabFilter2"
                        text="{i18n>tabUnificacion}"
                        key="Unificacion"
                    >
                        <VBox
                            id="_IDGenVBox2"
                            class="sapUiSmallMargin"
                        >
                            <Label id="_IDGenLabel5"
                                text="{i18n>labelFolio1}"
                                labelFor="uniFolio1"
                            />
                            <Input
                                id="uniFolio1"
                                maxLength="11"
                                placeholder="{i18n>phFolio1}"
                                width="200px"
                            />

                            <Label id="_IDGenLabel6"
                                text="{i18n>labelFolio2}"
                                labelFor="uniFolio2"
                                class="sapUiSmallMarginTop"
                            />
                            <Input
                                id="uniFolio2"
                                maxLength="11"
                                placeholder="{i18n>phFolio}"
                                width="200px"
                            />

                            <Button id="_IDGenButton2"
                                text="{i18n>btnUnificar}"
                                press="onUnificar"
                                class="sapUiSmallMarginTop"
                                type="Emphasized"
                            />
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
