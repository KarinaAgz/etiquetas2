<mvc:View
    controllerName="logaligroup.etiquetas.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true"
    height="100vh"
>
    <Page
        id="page"
        title="{i18n>title}"
        class="sapUiContentPadding sapUiResponsiveMargin"
        enableScrolling="true"
    >
        <content>
            <VBox
                id="_IDGenVBox1"
                class="sapUiResponsiveContentPadding"
                height="100%"
                fitContainer="true"
                width="100%"
            >
                <IconTabBar
                    id="idTabBar"
                    class="sapUiResponsiveMargin sapUiTinyMarginBegin sapUiTinyMarginTop"
                    expandable="false"
                    selectedKey="reimpresion"
                    width="100%"
                >
                    <items>
                        <IconTabFilter
                            id="_IDGenIconTabFilter"
                            text="{i18n>tabReimpresion}"
                            key="reimpresion"
                            tooltip="{i18n>tooltipReimpresion}"
                            design="Horizontal"
                        >
                            <VBox
                                id="_IDGenVBox2"
                                alignItems="Center"
                                width="80%"
                                height="100%"
                                class="sapUiSmallMargin"
                            >
                                <form:SimpleForm
                                    id="_IDGenSimpleForm"
                                    editable="true"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="3"
                                    labelSpanL="3"
                                    labelSpanM="5"
                                    labelSpanS="12"
                                    emptySpanXL="0"
                                    emptySpanL="5"
                                    emptySpanM="3"
                                    emptySpanS="0"
                                    columnsXL="1"
                                    columnsL="1"
                                    columnsM="1"
                                    maxContainerCols="2"
                                    class="sapUiSmallMargin sapUiResponsiveForm"
                                    width="100%"
                                >
                                    <form:content>
                                        <!-- Nueva Checkbox para modo Selectiva -->
                                        <CheckBox
                                            id="chkModoSelectivo"
                                            text="{i18n>labelModoSelectivo}"
                                            selected="{view>/modoSelectivo}"
                                            select="onCheckboxChange"
                                            class="sapUiSmallMarginTop"
                                        />
                                        
                                        <!-- Inputs Folio: Visible solo si NO selectiva -->
                                        <Label
                                            id="_IDGenLabel"
                                            text="{i18n>labelFolio}"
                                            labelFor="reimpFolio"
                                            design="Bold"
                                            required="true"
                                            visible="{=${view>/modoSelectivo} === false}"
                                        />
                                        <Input
                                            id="reimpFolio"
                                            maxLength="11"
                                            placeholder="{i18n>phFolio11}"
                                            width="100%"
                                            type="Number"
                                            valueState="None"
                                            liveChange="onInputChange"
                                            visible="{=${view>/modoSelectivo} === false}"
                                        />
                                        
                                        <!-- Input Folio Final: Visible solo si NO selectiva -->
                                        <Label
                                            id="newLabelFolioFinal"
                                            text="{i18n>labelFolioFinal}"
                                            labelFor="reimpFolioFinal"
                                            design="Bold"
                                            required="false"
                                            visible="{=${view>/modoSelectivo} === false}"
                                        />
                                        <Input
                                            id="reimpFolioFinal"
                                            maxLength="11"
                                            placeholder="{i18n>phFolioFinal}"
                                            width="100%"
                                            type="Number"
                                            valueState="None"
                                            liveChange="onInputChange"
                                            visible="{=${view>/modoSelectivo} === false}"
                                        />
                                        
                                        <!-- TextArea para Lista: Visible solo si selectiva -->
                                        <Label
                                            id="labelListaHUs"
                                            text="{i18n>labelListaHUs}"
                                            labelFor="txtListaHUs"
                                            design="Bold"
                                            visible="{=${view>/modoSelectivo} === true}"
                                        />
                                        <TextArea
                                            id="txtListaHUs"
                                            placeholder="{i18n>phListaHUs}"
                                            width="100%"
                                            rows="5"
                                            maxLength="2000"
                                            valueState="None"
                                            liveChange="onInputChange"
                                            visible="{=${view>/modoSelectivo} === true}"
                                        />
                                    </form:content>
                                    <Button
                                        id="_IDGenButton1"
                                        text="{i18n>btnReimprimir}"
                                        press="onReimprimir"
                                        class="sapUiResponsiveMargin sapUiTinyMarginTop"
                                        type="Emphasized"
                                        busyIndicatorDelay="0"
                                        tooltip="{i18n>tooltipReimprimir}"
                                        width="100%"
                                    />
                                </form:SimpleForm>
                            </VBox>
                        </IconTabFilter>
                        <!-- Tab 2: Partición -->
                        <IconTabFilter
                            id="_IDGenIconTabFilter1"
                            text="{i18n>tabParticion}"
                            key="particion"
                            tooltip="{i18n>tooltipParticion}"
                            design="Horizontal"
                        >
                            <!-- Form centrado -->
                            <VBox
                                id="_IDGenVBox3"
                                alignItems="Center"
                                width="80%"
                                height="100%"
                                class="sapUiSmallMargin"
                            >
                                <form:SimpleForm
                                    id="_IDGenSimpleForm1"
                                    editable="true"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="6"
                                    labelSpanL="3"
                                    labelSpanM="5"
                                    labelSpanS="12"
                                    emptySpanXL="4"
                                    emptySpanL="5"
                                    emptySpanM="3"
                                    emptySpanS="0"
                                    columnsXL="2"
                                    columnsL="2"
                                    columnsM="1"
                                    maxContainerCols="2"
                                    class="sapUiSmallMargin sapUiResponsiveForm"
                                    width="100%"
                                >
                                    <form:content>
                                        <Label
                                            id="_IDGenLabel1"
                                            text="{i18n>labelFolio}"
                                            labelFor="partFolio"
                                            required="true"
                                            design="Bold"
                                        />
                                        <Input
                                            id="partFolio"
                                            maxLength="11"
                                            placeholder="{i18n>phFolio11}"
                                            width="auto"
                                            type="Number"
                                            valueState="None"
                                            liveChange="onInputChange"
                                        />
                                        <Label
                                            id="_IDGenLabel2"
                                            text="{i18n>labelCantidad1}"
                                            labelFor="cant1"
                                            class="sapUiSmallMarginTop"
                                            design="Bold"
                                            required="true"
                                        />
                                        <Input
                                            id="cant1"
                                            type="Number"
                                            placeholder="{i18n>phCantidad1}"
                                            width="auto"
                                            valueState="None"
                                            min="1"
                                            liveChange="onInputChange"
                                        />
                                        <Label
                                            id="_IDGenLabel3"
                                            text="{i18n>labelCantidad2}"
                                            labelFor="cant2"
                                            class="sapUiSmallMarginTop"
                                            required="true"
                                            design="Bold"
                                        />
                                        <Input
                                            id="cant2"
                                            type="Number"
                                            placeholder="{i18n>phCantidad2}"
                                            width="auto"
                                            valueState="None"
                                            min="1"
                                            liveChange="onInputChange"
                                        />
                                    </form:content>

                                    <Button
                                        id="_IDGenButton2"
                                        text="{i18n>btnParticionar}"
                                        press="onParticionar"
                                        class="sapUiResponsiveMargin"
                                        type="Emphasized"
                                        busyIndicatorDelay="0"
                                        tooltip="{i18n>tooltipParticionar}"
                                        width="75%"
                                    />
                                </form:SimpleForm>
                            </VBox>
                        </IconTabFilter>

                        <!-- Tab 3: Unificación -->
                        <IconTabFilter
                            id="_IDGenIconTabFilter2"
                            text="{i18n>tabUnificacion}"
                            key="unificacion"
                            tooltip="{i18n>tooltipUnificacion}"
                            design="Horizontal"
                        >
                            <VBox
                                id="_IDGenVBox4"
                                alignItems="Center"
                                width="80%"
                                class="sapUiSmallMargin"
                            >
                                <form:SimpleForm
                                    id="_IDGenSimpleForm2"
                                    editable="true"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="4"
                                    labelSpanL="3"
                                    labelSpanM="5"
                                    labelSpanS="12"
                                    emptySpanXL="4"
                                    emptySpanL="5"
                                    emptySpanM="3"
                                    emptySpanS="0"
                                    columnsXL="2"
                                    columnsL="2"
                                    columnsM="1"
                                    maxContainerCols="2"
                                    class="sapUiSmallMargin sapUiResponsiveForm"
                                    width="100%"
                                >
                                    <form:content>
                                        <Label
                                            id="_IDGenLabel4"
                                            text="{i18n>labelFolio1}"
                                            labelFor="uniFolio1"
                                            required="true"
                                            design="Bold"
                                        />
                                        <Input
                                            id="uniFolio1"
                                            maxLength="11"
                                            placeholder="{i18n>phFolio1}"
                                            width="auto"
                                            type="Number"
                                            valueState="None"
                                            liveChange="onInputChange"
                                        />
                                        <Label
                                            id="_IDGenLabel5"
                                            text="{i18n>labelFolio2}"
                                            labelFor="uniFolio2"
                                            class="sapUiSmallMarginTop"
                                            required="true"
                                            design="Bold"
                                        />
                                        <Input
                                            id="uniFolio2"
                                            maxLength="11"
                                            placeholder="{i18n>phFolio2}"
                                            width="auto"
                                            type="Number"
                                            valueState="None"
                                            liveChange="onInputChange"
                                        />
                                    </form:content>
                                    <Button
                                        id="_IDGenButton3"
                                        text="{i18n>btnUnificar}"
                                        press="onUnificar"
                                        class="sapUiResponsiveMargin"
                                        type="Emphasized"
                                        busyIndicatorDelay="0"
                                        tooltip="{i18n>tooltipUnificar}"
                                        width="75%"
                                    />
                                </form:SimpleForm>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>