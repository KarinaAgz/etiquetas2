<mvc:View
    controllerName="logaligroup.etiquetas.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100vh"
>
    <Page id="_IDGenPage1" title="{i18n>title}" showNavButton="false" class="sapUiResponsiveMargin sapUiContentPadding">

        <!-- HEADER COMÚN -->
        <customHeader>
            <Bar id="_IDGenBar" class="sapUiSmallMargin">
                <contentLeft>
                    <Title id="_IDGenTitle" text="ETIQUETAS" level="H5" class="sapUiTinyMarginBegin"/>
                </contentLeft>
                <contentMiddle>
                    <SegmentedButton id="_IDGenSegmentedButton" selectedKey="{view>/printer}" selectionChange="onImpresoraChange">
                        <items>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem" text="PDF"   key="pdf" width="70%"  />
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem1" text="Zebra" key="zebra" width="70%"/>
                        </items>
                    </SegmentedButton>
                    <ToolbarSeparator id="_IDGenToolbarSeparator1" />
                    <ToolbarSeparator id="_IDGenToolbarSeparator2" />
                    <ToolbarSeparator id="_IDGenToolbarSeparator3" />
                    <CheckBox 
                        id="_IDGenCheckBox"
                        text="Con logotipo"
                        selected="{view>/logo}"
                        select="onLogoChange"
                        class="sapUiSmallMarginTop sapUiSmallMarginBottom"
                        width="100%"
                    />
                </contentMiddle>
                <contentRight>
                    <VBox id="_IDGenVBox">
                        <Text id="_IDGenText" text="{sap.ushell/Container>getUser>getFullName()}"/>
                        <HBox id="_IDGenHBox">
                            <Label id="_IDGenLabel" text="Centro:" class="sapUiTinyMarginEnd"/>
                            <Text id="_IDGenText1" text="{view>/werks}"/>
                            <Label id="_IDGenLabel1" text="Almacén:" class="sapUiSmallMarginBeginEnd"/>
                            <Text id="_IDGenText2" text="{view>/lgort}"/>
                        </HBox>
                    </VBox>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox id="_IDGenVBox1" class="sapUiResponsiveContentPadding" fitContainer="true">
                <IconTabBar id="_IDGenIconTabBar" expandable="false" selectedKey="reimpresion" class="sapUiResponsiveMargin">
                    <items>

                        <!-- REIMPRESIÓN -->
                        <IconTabFilter id="_IDGenIconTabFilter" text="{i18n>tabReimpresion}" key="reimpresion">
                            <VBox id="_IDGenVBox2" alignItems="Center" class="sapUiLargeMarginTopBottom">

                                <HBox id="_IDGenHBox1" justifyContent="Center" class="sapUiMediumMarginBottom">
                                    <CheckBox id="_IDGenCheckBox1" text="Modo selectivo (lista)" 
                                              selected="{view>/modoSelectivo}" 
                                              select="onModoSelectivoChange"/>
                                    <Text id="_IDGenText3" text="Cantidad: {view>/cantidadHUs}" 
                                          visible="{view>/modoSelectivo}" 
                                          class="sapUiSmallMarginBegin"/>
                                </HBox>

                                <form:SimpleForm id="_IDGenSimpleForm" visible="{= !${view>/modoSelectivo} }" editable="true" layout="ResponsiveGridLayout" width="100%">
                                    <form:content>
                                        <Label id="_IDGenLabel2" text="Folio inicial" required="true"/>
                                        <Input id="reimpFolio" type="Text" maxLength="11" placeholder="Ej: 92345670001" liveChange="onInputChange"/>
                                        <Label id="_IDGenLabel3" text="Folio final (opcional)"/>
                                        <Input id="reimpFolioFinal" type="Text" maxLength="11" placeholder="Para rango" liveChange="onInputChange"/>
                                    </form:content>
                                    <Button id="_IDGenButton" text="Reimprimir" type="Emphasized" press="onReimprimir" width="100%"/>
                                </form:SimpleForm>

                                <VBox id="_IDGenVBox3" visible="{view>/modoSelectivo}" alignItems="Stretch" >
                                    <TextArea id="txtListaReimp"   
                                              placeholder="Pega los folios..."
                                              width="80%"
                                              height="60%"
                                              rows="10"
                                              growing="true"
                                              growingMaxLines="20"
                                              liveChange="onInputChange"
                                              class="sapUiSmallMarginBottom"/>
                                    <Text id="_IDGenText4" text="Máximo 100 folios" class="sapUiTinyMarginBottom"/>

                                    <Button id="_IDGenButton1" text="Reimprimir lista" type="Emphasized" press="onReimprimir" width="250px" height="50%">
                                    <layoutData>
                                        <FlexItemData id="_IDGenFlexItemData" alignSelf="Center"/>
                                    </layoutData>
                                    </Button>
                                </VBox>
                            </VBox>
                        </IconTabFilter>

                        <!-- PARTICIÓN -->
                        <IconTabFilter id="_IDGenIconTabFilter1" text="{i18n>tabParticion}" key="particion">
                            <VBox id="_IDGenVBox4" alignItems="Center" class="sapUiLargeMarginTopBottom">
                                <HBox id="_IDGenHBox2" justifyContent="Center" class="sapUiMediumMarginBottom">
                                    <CheckBox id="_IDGenCheckBox2" text="Modo masivo (lista de HUs)" 
                                              selected="{view>/modoMasivo}" 
                                              select="onModoMasivoChange"/>
                                    <Text id="_IDGenText5" text="Cantidad: {view>/cantidadHUs}" visible="{view>/modoMasivo}"/>
                                </HBox>

                                <form:SimpleForm id="_IDGenSimpleForm1" visible="{= !${view>/modoMasivo} }" editable="true" layout="ResponsiveGridLayout" width="70%">
                                    <form:content>
                                        <Label id="_IDGenLabel4" text="Folio HU" required="true"/>
                                        <Input id="partFolio" type="Text" maxLength="11" placeholder="Folio" liveChange="onInputChange"/>
                                        <Label id="_IDGenLabel5" text="Cantidad parte 1" required="true"/>
                                        <Input id="cant1" type="Number" placeholder="Ej: 50"/>
                                        <Label id="_IDGenLabel6" text="Cantidad parte 2" required="true"/>
                                        <Input id="cant2" type="Number" placeholder="Ej: 50"/>
                                    </form:content>
                                    <Button id="_IDGenButton2" text="Particionar HU" type="Emphasized" press="onParticionar" width="100%"/>
                                </form:SimpleForm>

                                <VBox id="_IDGenVBox5" visible="{view>/modoMasivo}" alignItems="Stretch">
                                    <TextArea id="txtListaPart"   
                                              placeholder="Pega los folios a particionar..."
                                              width="80%"
                                              rows="8"
                                              growing="true"
                                              liveChange="onInputChange"/>
                                    <Text text="En desarrollo - modo masivo" class="sapUiSmallMarginTop sapUiMediumFontSize" />
                                </VBox>
                            </VBox>
                        </IconTabFilter>

                        <!-- UNIFICACIÓN -->
                        <IconTabFilter id="_IDGenIconTabFilter2" text="{i18n>tabUnificacion}" key="unificacion">
                            <VBox id="_IDGenVBox6" alignItems="Center" class="sapUiLargeMarginTopBottom">
                                <HBox id="_IDGenHBox3" justifyContent="Center" class="sapUiMediumMarginBottom">
                                    <CheckBox id="_IDGenCheckBox3" text="Modo masivo (lista de HUs)" 
                                              selected="{view>/modoMasivo}" 
                                              select="onModoMasivoChange"/>
                                    <Text id="_IDGenText7" text="Cantidad: {view>/cantidadHUs}" visible="{view>/modoMasivo}"/>
                                </HBox>

                                <form:SimpleForm id="_IDGenSimpleForm2" visible="{= !${view>/modoMasivo} }" editable="true" layout="ResponsiveGridLayout" width="70%">
                                    <form:content>
                                        <Label id="_IDGenLabel7" text="Folio HU 1" required="true"/>
                                        <Input id="uniFolio1" type="Text" maxLength="11" placeholder="Primer folio" liveChange="onInputChange"/>
                                        <Label id="_IDGenLabel8" text="Folio HU 2" required="true"/>
                                        <Input id="uniFolio2" type="Text" maxLength="11" placeholder="Segundo folio" liveChange="onInputChange"/>
                                    </form:content>
                                    <Button id="_IDGenButton3" text="Unificar HUs" type="Emphasized" press="onUnificar" width="100%"/>
                                </form:SimpleForm>

                                <VBox id="_IDGenVBox7" visible="{view>/modoMasivo}" alignItems="Stretch" width="100%" height="100%">
                                    <TextArea id="txtListaUnif"   
                                              placeholder="Pega los folios a unificar..."
                                              width="80%"
                                              height="60%"
                                              rows="10"
                                              growing="true"
                                              growingMaxLines="20"
                                              liveChange="onInputChange"/>
                                    <Text text="Modo masivo disponible cuando el backend lo soporte" class="sapUiSmallMarginTop"/>
                                </VBox>
                            </VBox>
                        </IconTabFilter>

                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>