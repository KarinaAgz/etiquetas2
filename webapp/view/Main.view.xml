<mvc:View
    controllerName="logaligroup.etiquetas.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true"
    height="100vh"
>
    <Page
        id="page"
        title="{i18n>title}"
        class="sapUiContentPadding sapUiResponsiveMargin"
        enableScrolling="true"
    >
        <!-- HEADER COMÚN (fijo arriba) -->
        <subHeader>
            <Toolbar class="sapUiMediumMarginBeginEnd sapUiSmallMarginTopBottom">
                <Label text="{i18n>labelCentro}" class="sapUiTinyMarginEnd"/>
                <Label text="{i18n>labelAlmacen}" class="sapUiTinyMarginEnd"/>
                <ToolbarSpacer/>
                <Label text="{i18n>labelImpresora}" class="sapUiTinyMarginEnd"/>
                <Select
                    id="selImpresora"
                    selectedKey="{view>/printer}"
                    change="onImpresoraChange"
                    width="160px"
                >
                    <core:Item key="pdf" text="{i18n>optionPdfLocal}"/>
                    <core:Item key="zebra" text="{i18n>optionZebraIP}"/>
                </Select>
                <CheckBox
                    id="chkLogo"
                    text="{i18n>labelLogo}"
                    selected="{view>/logo}"
                    select="onLogoChange"
                    class="sapUiMediumMarginBeginEnd"
                />
                <Label text="{i18n>labelUsuario, ['Usuario Actual']}" class="sapUiTinyMarginBegin"/>
            </Toolbar>
        </subHeader>

        <!-- CONTENIDO PRINCIPAL -->
        <content>
            <VBox class="sapUiResponsiveContentPadding" height="100%" fitContainer="true" width="100%">
                <IconTabBar
                    id="idTabBar"
                    class="sapUiResponsiveMargin sapUiTinyMarginBegin sapUiTinyMarginTop"
                    expandable="false"
                    selectedKey="reimpresion"
                    width="100%"
                >
                    <items>

                        <!-- TAB REIMPRESIÓN -->
                        <IconTabFilter
                            id="_IDGenIconTabFilter"
                            text="{i18n>tabReimpresion}"
                            key="reimpresion"
                            tooltip="{i18n>tooltipReimpresion}"
                            design="Horizontal"
                        >
                            <VBox alignItems="Center" width="80%" height="100%" class="sapUiSmallMargin">
                                <form:SimpleForm
                                    id="_IDGenSimpleForm"
                                    editable="true"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="3" labelSpanL="3" labelSpanM="5" labelSpanS="12"
                                    emptySpanXL="0" emptySpanL="5" emptySpanM="3" emptySpanS="0"
                                    columnsXL="1" columnsL="1" columnsM="1"
                                    maxContainerCols="2"
                                    class="sapUiSmallMargin sapUiResponsiveForm"
                                    width="100%"
                                >
                                    <form:content>
                                        <!-- Checkbox Modo Selectiva -->
                                        <CheckBox
                                            id="chkModoSelectivo"
                                            text="{i18n>labelModoSelectivo}"
                                            selected="{view>/modoSelectivo}"
                                            select="onCheckboxChange"
                                            class="sapUiMediumMarginTopBottom"
                                        />

                                        <!-- Modo Individual / Rango -->
                                        <Label text="{i18n>labelFolio}" labelFor="reimpFolio" design="Bold" required="true"
                                               visible="{=${view>/modoSelectivo} === false}"/>
                                        <Input id="reimpFolio" maxLength="11" placeholder="{i18n>phFolio11}"
                                               width="100%" type="Number" valueState="None" liveChange="onInputChange"
                                               visible="{=${view>/modoSelectivo} === false}"/>

                                        <Label text="{i18n>labelFolioFinal}" labelFor="reimpFolioFinal" design="Bold"
                                               visible="{=${view>/modoSelectivo} === false}"/>
                                        <Input id="reimpFolioFinal" maxLength="11" placeholder="{i18n>phFolioFinal}"
                                               width="100%" type="Number" valueState="None" liveChange="onInputChange"
                                               visible="{=${view>/modoSelectivo} === false}"/>

                                        <!-- Modo Selectiva (Lista) -->
                                        <Label text="{i18n>labelListaHUs}" labelFor="txtListaHUs" design="Bold"
                                               visible="{=${view>/modoSelectivo} === true}"/>
                                        <TextArea
                                            id="txtListaHUs"
                                            placeholder="{i18n>phListaHUs}"
                                            width="100%" rows="6" maxLength="3000"
                                            valueState="None" liveChange="onInputChange"
                                            visible="{=${view>/modoSelectivo} === true}"
                                        />
                                    </form:content>

                                    <Button
                                        id="_IDGenButton1"
                                        text="{i18n>btnReimprimir}"
                                        press="onReimprimir"
                                        type="Emphasized"
                                        class="sapUiMediumMarginTop"
                                        width="100%"
                                    />
                                </form:SimpleForm>
                            </VBox>
                        </IconTabFilter>

                        <!-- TAB PARTICIÓN (sin cambios) -->
                        <IconTabFilter text="{i18n>tabParticion}" key="particion" design="Horizontal">
                            <VBox alignItems="Center" width="80%" height="100%" class="sapUiSmallMargin">
                                <form:SimpleForm editable="true" layout="ResponsiveGridLayout"
                                    labelSpanXL="6" labelSpanL="3" labelSpanM="5" labelSpanS="12"
                                    emptySpanXL="4" emptySpanL="5" emptySpanM="3" emptySpanS="0"
                                    columnsXL="2" columnsL="2" columnsM="1" maxContainerCols="2"
                                    class="sapUiSmallMargin sapUiResponsiveForm" width="100%">
                                    <form:content>
                                        <Label text="{i18n>labelFolio}" labelFor="partFolio" required="true" design="Bold"/>
                                        <Input id="partFolio" maxLength="11" placeholder="{i18n>phFolio11}" type="Number" liveChange="onInputChange"/>
                                        <Label text="{i18n>labelCantidad1}" labelFor="cant1" required="true" design="Bold" class="sapUiSmallMarginTop"/>
                                        <Input id="cant1" type="Number" placeholder="{i18n>phCantidad1}" min="1" liveChange="onInputChange"/>
                                        <Label text="{i18n>labelCantidad2}" labelFor="cant2" required="true" design="Bold" class="sapUiSmallMarginTop"/>
                                        <Input id="cant2" type="Number" placeholder="{i18n>phCantidad2}" min="1" liveChange="onInputChange"/>
                                    </form:content>
                                    <Button text="{i18n>btnParticionar}" press="onParticionar" type="Emphasized" width="75%" class="sapUiMediumMarginTop"/>
                                </form:SimpleForm>
                            </VBox>
                        </IconTabFilter>

                        <!-- TAB UNIFICACIÓN (sin cambios) -->
                        <IconTabFilter text="{i18n>tabUnificacion}" key="unificacion" design="Horizontal">
                            <VBox alignItems="Center" width="80%" height="100%" class="sapUiSmallMargin">
                                <form:SimpleForm editable="true" layout="ResponsiveGridLayout"
                                    labelSpanXL="4" labelSpanL="3" labelSpanM="5" labelSpanS="12"
                                    emptySpanXL="4" emptySpanL="5" emptySpanM="3" emptySpanS="0"
                                    columnsXL="2" columnsL="2" columnsM="1" maxContainerCols="2"
                                    class="sapUiSmallMargin sapUiResponsiveForm" width="100%">
                                    <form:content>
                                        <Label text="{i18n>labelFolio1}" labelFor="uniFolio1" required="true" design="Bold"/>
                                        <Input id="uniFolio1" maxLength="11" placeholder="{i18n>phFolio1}" type="Number" liveChange="onInputChange"/>
                                        <Label text="{i18n>labelFolio2}" labelFor="uniFolio2" required="true" design="Bold" class="sapUiSmallMarginTop"/>
                                        <Input id="uniFolio2" maxLength="11" placeholder="{i18n>phFolio2}" type="Number" liveChange="onInputChange"/>
                                    </form:content>
                                    <Button text="{i18n>btnUnificar}" press="onUnificar" type="Emphasized" width="75%" class="sapUiMediumMarginTop"/>
                                </form:SimpleForm>
                            </VBox>
                        </IconTabFilter>

                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>